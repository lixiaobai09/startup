set encoding=utf-8

function! SetTabs(size)
  execute "set tabstop=" . a:size
  execute "set shiftwidth=" . a:size
  execute "set softtabstop=" . a:size
endfunction
" autocmd VimEnter * call SetTabs(2)
command! -nargs=1 SetTabs call SetTabs(<args>)

" copy present word + relative file name to system clipboard
function! CopyFileNameAndKeyToClipboard()
  let content = expand('<cword>') . "\nfile: " . expand('%:.')
  let @+ = content
  echo "Copied " . @+ . " to clipboard"
endfunction
command! CN call CopyFileNameAndKeyToClipboard()

" copy relative file name and line number to system clipboard
" if no selected text, copy current line number,
"   if selected text, copy the first line number - last line number, eg 5-10
function! CopyFileNameToClipboard() range
  if a:firstline != a:lastline
    let content = expand('%:.') . ":" . a:firstline . "-" . a:lastline
  else
    let content = expand('%:.') . ":" . a:firstline
  endif
  let @+ = content
  echo "Copied " . @+ . " to clipboard"
endfunction
command! -range CF <line1>,<line2>call CopyFileNameToClipboard()

" use Sync "dst:/dir" means rsync present relative file to the same dir on dst
function! SyncToRemote(dst)
  let src = expand('%:.')
  let cmd = 'rsync -avz --progress ' . src . ' ' . a:dst . '/' . src
  echo "Executing: " . cmd
  " excute cmd in terminal to see progress
  execute '!' . cmd
endfunction
command! -nargs=1 Sync call SyncToRemote(<f-args>)

" set syntastic plugin to passive
let g:syntastic_mode_map = { 'mode': 'passive'}
set colorcolumn=80


if count(g:spf13_bundle_groups, 'deoplete')
  " for copilot
  imap <silent><script><expr> <C-J> copilot#Accept("\<CR>")
  let g:copilot_no_tab_map = v:true
  nmap - <Plug>(copilot-accept-word)
  imap <C-L> <Plug>(copilot-accept-word)
  " nmap - <Plug>(copilot-next)
  " imap <C-J> <Plug>(copilot-next)
endif

" for macos vertical window roll
set ttymouse=sgr
set mouse=a
" set mouse=""
" the copilot is conflict with deoplete plugin, disable one of them
" or disable copilot plugin with vim command : Copilot disable, and
" remove following line
let g:deoplete#enable_at_startup = 0
" not to remove trailing whitespace
let g:spf13_keep_trailing_whitespace = 1
colorscheme sonokai

" CtrlP: force ag-based file listing instead of `git ls-files`.
" `git ls-files` at a superproject root treats submodules (e.g.
" github-opensource/) as opaque gitlinks and won't recurse into them,
" so files inside submodules never show up in CtrlP. `ag` just walks
" the directory tree (still honoring .gitignore) and doesn't care
" about submodule boundaries, so it finds files on both sides.
if executable('ag')
    let g:ctrlp_user_command = 'ag %s -l --nocolor -g ""'
endif

" 确保只在整个 Vim 启动和退出时处理 tag 栈，避免频繁覆盖
augroup HardcoreTagStack
    autocmd!
    " 1. 只有在整个 Vim 刚启动、且进入第一个文件后，才恢复一次历史栈
    autocmd VimEnter * call s:RestoreTagStackGlobal()
    " 2. 只有在完全退出 Vim 时，才将当前的最新栈持久化
    autocmd VimLeavePre * call s:SaveTagStackGlobal()
augroup END

function! s:SaveTagStackGlobal()
    let l:winid = win_getid()
    let l:stack = gettagstack(l:winid)

    " 如果 tag 栈彻底为空，直接删掉旧文件，免得下次误载
    if empty(l:stack) || l:stack.length == 0
        if filereadable('.tagstack') | call delete('.tagstack') | endif
        return
    endif

    " 将最新的栈持久化到当前目录下的隐藏文件中
    call writefile([json_encode(l:stack)], '.tagstack')
endfunction

function! s:RestoreTagStackGlobal()
    if filereadable('.tagstack')
        let l:lines = readfile('.tagstack')
        if !empty(l:lines)
            let l:stack = json_decode(l:lines[0])
            let l:winid = win_getid()
            " 用 'r' 彻底替换当前窗口的栈
            call settagstack(l:winid, l:stack, 'r')
        endif
    endif
endfunction

